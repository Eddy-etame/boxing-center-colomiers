---
/**
 * Gabarit des quatre pages disciplines.
 *
 * Une seule structure, quatre contenus. Il n'y a pas de variante par page :
 * si une discipline mérite un traitement différent, c'est le contenu qui
 * change, pas la mise en page — sinon le site perd sa cohérence en trois
 * modifications.
 */
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Bascule from '../components/Bascule.astro';
import { contenu, type Contenu } from '../data/contenus';
import { discipline, CLUBS, HORAIRES, DISCIPLINES, CONTACT } from '../data/verite';
import { FAMILLES_PAR_PAGE, OFFRES } from '../data/offres';
import { route } from '../data/routes';

interface Props { id: Contenu['id'] }
const { id } = Astro.props;

const c = contenu(id);
const d = discipline(id);
const autres = DISCIPLINES.filter((x) => x.id !== id);

/**
 * Les intitulés réellement publiés par chaque club pour cette discipline.
 * C'est ce qui distingue la page d'une fiche générique : « Boxing Lady »,
 * « Baby Boxe 3/6 » ou « Grappling & jiu-jitsu brésilien » sont le vocabulaire
 * que les gens tapent, et personne d'autre ne peut les écrire à notre place.
 */
const familles = FAMILLES_PAR_PAGE[id] ?? [];
const offresParClub = CLUBS.map((c) => ({
  club: c,
  offres: OFFRES.filter((o) => o.club === c.id && familles.includes(o.famille)),
})).filter((x) => x.offres.length > 0);
---

<Base page={id} discipline={id} ogPhoto={c.photoHero} faq={c.faq}>
  {/* ── Chapeau : la réponse avant tout le reste ── */}
  <section class="section tete" aria-labelledby="t-page">
    <div class="enveloppe tete__inner">
      <nav class="fil mono" aria-label="Fil d’Ariane">
        <a href="/">Accueil</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{d.nom}</span>
      </nav>

      <h1 id="t-page">{c.h1}</h1>

      {/* Bloc-réponse : c'est ce que citent Google et les moteurs de réponse. */}
      <p class="tete__chapeau">{c.chapeau}</p>

      <div class="tete__actions">
        <a class="bouton bouton--signal" href="#trouver">
          <span>Quel club pour moi</span>
          <span class="fleche" aria-hidden="true">↓</span>
        </a>
        <a class="bouton" href={route('contact').chemin}>
          <span>Poser ma question</span>
          <span class="fleche" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="enveloppe">
      <Photo slug={c.photoHero} prioritaire sizes="100vw" ratio="21 / 9" class="tete__photo" legende />
    </div>
  </section>

  {/* ── Le corps éditorial ── */}
  <section class="section clair corps" aria-labelledby="t-corps">
    <div class="enveloppe">
      <h2 id="t-corps" class="vh">En détail</h2>
      <div class="corps__grille">
        {c.blocs.map((b, i) => (
          <article class="bloc reveler" style={`--retard:${i * 60}ms`}>
            <p class="mono bloc__num">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="bloc__titre">{b.titre}</h3>
            <p class="bloc__texte">{b.texte}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {c.bascule && (
    <section class="section vue" aria-labelledby="t-vue">
      <div class="enveloppe">
        <p class="numero-section mono"><span>En salle</span></p>
        <h2 id="t-vue" class="vue__titre">Voilà à quoi ça ressemble vraiment.</h2>
      </div>
      <Bascule nom={c.bascule} sizes="100vw" ratio="16 / 9" />
      <div class="enveloppe">
        <p class="mono vue__legende">Boxing Center Toulouse Minimes</p>
      </div>
    </section>
  )}

  {/* ── Le déroulé d'une séance ── */}
  <section class="section seance" aria-labelledby="t-seance">
    <div class="enveloppe seance__inner">
      <div class="seance__texte">
        <p class="numero-section mono"><span>Une séance</span></p>
        <h2 id="t-seance">À quoi ressemble une séance, dans l’ordre.</h2>
        <p class="lead faible">
          Le déroulé varie selon le coach et le cycle en cours, mais l’ossature
          est celle-ci. Rien n’est laissé au hasard, et rien n’est improvisé.
        </p>
        <ol class="seance__liste">
          {c.seance.map((e, i) => (
            <li>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>
              <span>{e}</span>
            </li>
          ))}
        </ol>
        <p class="seance__duree mono">
          Amplitude d’accueil des clubs : {HORAIRES.texte.valeur}
        </p>
      </div>
      <div class="seance__image">
        <Photo
          slug={c.photoSecondaire}
          sizes="(max-width: 60rem) 100vw, 42vw"
          ratio="3 / 4" legende />
      </div>
    </div>
  </section>

  {/* ── Où pratiquer, depuis Colomiers ── */}
  <section class="section papier trouver" id="trouver" aria-labelledby="t-trouver">
    <div class="enveloppe">
      <p class="numero-section mono"><span>Depuis Colomiers</span></p>
      <h2 id="t-trouver">Où pratiquer {d.nom.toLowerCase()} à proximité de Colomiers</h2>
      <p class="lead trouver__intro">
        {offresParClub.length === 1
          ? `Dans le réseau Boxing Center, c’est ${offresParClub[0].club.nom} qui propose cette pratique, ${HORAIRES.texte.valeur.toLowerCase()}. Voilà ce que le club publie exactement.`
          : `Les deux clubs Boxing Center à proximité de Colomiers la proposent, ${HORAIRES.texte.valeur.toLowerCase()}. Voilà ce que chacun publie exactement.`}
      </p>

      <div class="trouver__clubs">
        {offresParClub.map(({ club: cl, offres }) => (
          <a class="tclub" href={cl.activites} rel="noopener">
            <h3 class="tclub__nom">{cl.nomCourt}</h3>
            <ul class="tclub__offres">
              {offres.map((o) => (
                <li>
                  <span class="tclub__intitule">{o.intitule}</span>
                  {o.ages && <span class="tclub__age mono">{o.ages}</span>}
                  {o.detail && <span class="tclub__detail">{o.detail}</span>}
                </li>
              ))}
            </ul>
            <p class="tclub__angle">{cl.angle}</p>
            <p class="mono tclub__depuis">{cl.adresse} — {cl.depuisColomiers}</p>
            <span class="mono tclub__aller">
              Voir les activités du club <span aria-hidden="true">↗</span>
            </span>
          </a>
        ))}
      </div>

      <p class="trouver__aide">
        Tu ne sais pas lequel choisir&nbsp;?
        <a class="lien" href="/quel-club/">Minimes ou Portet : réponds à deux questions</a>,
        ou <a class="lien" href={route('contact').chemin}>écris-nous directement</a>.
      </p>
    </div>
  </section>

  {/* ── FAQ ── */}
  <section class="section faq" aria-labelledby="t-faq">
    <div class="enveloppe faq__inner">
      <div>
        <p class="numero-section mono"><span>Questions</span></p>
        <h2 id="t-faq">Ce qu’on nous demande le plus souvent.</h2>
      </div>
      <div class="faq__liste">
        {c.faq.map((q) => (
          <details class="qr">
            <summary>
              <span class="qr__q">{q.titre}</span>
              <span class="qr__signe" aria-hidden="true"></span>
            </summary>
            <p class="qr__r">{q.texte}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ── Les autres disciplines ── */}
  <section class="section clair suite" aria-labelledby="t-suite">
    <div class="enveloppe">
      <p class="numero-section mono"><span>Les autres disciplines</span></p>
      <h2 id="t-suite" class="suite__titre">Ce n’est peut-être pas ça que tu cherches.</h2>
      <ul class="suite__liste">
        {autres.map((a) => (
          <li>
            <a href={a.route}>
              <span class="suite__nom">{a.nom}</span>
              <span class="suite__q mono">«&nbsp;{a.question}&nbsp;»</span>
              <span class="suite__fleche" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  {/* ── Conversion : la page finit par une action, pas par une sortie ── */}
  <section class="section conversion" aria-labelledby="t-conversion">
    <div class="enveloppe conversion__inner">
      <p class="numero-section mono"><span>Passer à l’acte</span></p>
      <h2 id="t-conversion" class="conversion__titre">{c.promesse}</h2>
      <p class="lead conversion__texte">
        Deux clubs à proximité de Colomiers, {HORAIRES.texte.valeur.toLowerCase()}.
        Si tu sais lequel viser, ouvre son site. Si tu hésites, dis-nous ce que tu
        cherches&nbsp;: on te répond avec le club et le créneau qui te correspondent.
      </p>
      <div class="conversion__actions">
        <a class="bouton bouton--signal" href={route('contact').chemin}>
          <span>Poser ma question</span>
          <span class="fleche" aria-hidden="true">→</span>
        </a>
        <a class="bouton" href={`tel:${CONTACT.telephoneLien.valeur}`}>
          <span>{CONTACT.telephone.valeur}</span>
          <span class="fleche" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ── Chapeau ──────────────────────────────────────────────────────── */
  .tete { padding-bottom: var(--e-6); }
  .tete__inner { max-width: 60rem; }

  .fil { display: flex; gap: var(--e-2); margin-bottom: var(--e-5); }
  .fil a { color: var(--acier-sombre); text-decoration: none; }
  .fil a:hover { color: var(--signal-texte); }
  .fil span[aria-current] { color: var(--acier); }

  .tete h1 { max-width: 18ch; margin-bottom: var(--e-5); }

  /* Le bloc-réponse se distingue visuellement : c'est la phrase que la page
     doit faire lire en premier, humain comme robot. */
  .tete__chapeau {
    max-width: 60ch;
    padding-left: var(--e-5);
    border-left: 2px solid var(--signal);
    font-size: var(--t-lead);
    line-height: 1.5;
    color: var(--acier);
  }

  .tete__actions { display: flex; flex-wrap: wrap; gap: var(--e-3); margin-top: var(--e-6); }
  .tete__photo { margin-top: var(--e-8); }

  /* ── Corps ────────────────────────────────────────────────────────── */
  .corps__grille {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e-8) var(--e-8);
  }
  @media (max-width: 60rem) { .corps__grille { grid-template-columns: 1fr; gap: var(--e-7); } }

  .bloc__num { color: var(--signal-texte); margin-bottom: var(--e-3); }
  .bloc__titre { font-size: var(--t-h3); margin-bottom: var(--e-3); max-width: 24ch; }
  .bloc__texte { max-width: 58ch; color: var(--texte-faible); }

  /* ── Séance ───────────────────────────────────────────────────────── */
  .seance__inner {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--e-8);
    align-items: start;
  }
  @media (max-width: 60rem) {
    .seance__inner { grid-template-columns: 1fr; }
    .seance__image { max-width: 24rem; }
  }
  .seance h2 { max-width: 20ch; margin-bottom: var(--e-4); }
  .seance .lead { max-width: 50ch; }

  .seance__liste { list-style: none; margin-top: var(--e-6); }
  .seance__liste li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--e-3);
    padding: var(--e-4) 0;
    border-top: 1px solid var(--trait);
    align-items: baseline;
  }
  .seance__liste li:last-child { border-bottom: 1px solid var(--trait); }
  .seance__liste .mono { color: var(--signal-texte); }
  .seance__duree {
    margin-top: var(--e-5);
    color: var(--acier-sombre);
    text-transform: none;
    letter-spacing: 0.05em;
  }

  /* ── Trouver ──────────────────────────────────────────────────────── */
  .trouver h2 { max-width: 22ch; margin-bottom: var(--e-4); }
  .trouver__intro { max-width: 56ch; color: var(--texte-faible); }

  .trouver__clubs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e-5);
    margin-top: var(--e-7);
  }
  @media (max-width: 52rem) { .trouver__clubs { grid-template-columns: 1fr; } }

  .tclub {
    display: grid;
    gap: var(--e-2);
    padding: var(--e-5);
    border: 1px solid var(--trait);
    border-radius: var(--rayon-1);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--d-rapide) var(--e-mecanique),
      transform var(--d-normal) var(--e-sortie);
  }
  .tclub:hover { border-color: var(--signal-texte); transform: translateY(-2px); }
  .tclub__nom { font-size: var(--t-h3); }
  .tclub__offres { list-style: none; display: grid; gap: var(--e-2); margin: var(--e-2) 0 var(--e-3); }
  .tclub__offres li { display: grid; gap: 0.05rem; }
  .tclub__intitule {
    font-size: var(--t-petit);
    font-weight: 600;
    border-left: 2px solid var(--signal);
    padding-left: var(--e-3);
  }
  .tclub__age,
  .tclub__detail {
    padding-left: calc(var(--e-3) + 2px);
    font-size: var(--t-micro);
    color: var(--texte-faible);
    line-height: 1.5;
  }
  .tclub__age { color: var(--signal-texte); text-transform: none; letter-spacing: 0.05em; }
  .tclub__angle { margin: 0; color: var(--texte-faible); font-size: var(--t-petit); }
  .tclub__depuis {
    margin: 0;
    padding-top: var(--e-3);
    border-top: 1px solid var(--trait-faible);
    text-transform: none;
    color: var(--texte-faible);
  }
  .tclub__aller { color: var(--signal-texte); margin-top: var(--e-2); }

  .trouver__aide { margin-top: var(--e-6); font-size: var(--t-petit); color: var(--texte-faible); }

  /* ── FAQ ──────────────────────────────────────────────────────────── */
  .faq__inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--e-8);
    align-items: start;
  }
  @media (max-width: 60rem) { .faq__inner { grid-template-columns: 1fr; gap: var(--e-6); } }
  .faq h2 { max-width: 16ch; }

  .qr { border-top: 1px solid var(--trait); }
  .qr:last-child { border-bottom: 1px solid var(--trait); }
  .qr summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
    padding: var(--e-4) 0;
    cursor: pointer;
    list-style: none;
  }
  .qr summary::-webkit-details-marker { display: none; }
  .qr__q { font-weight: 600; font-size: var(--t-base); }
  .qr summary:hover .qr__q { color: var(--signal-texte); }

  /* Un plus qui devient un moins : la rotation dit l'état sans icône. */
  .qr__signe {
    flex: none;
    position: relative;
    width: 14px;
    height: 14px;
  }
  .qr__signe::before,
  .qr__signe::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--signal);
  }
  .qr__signe::before { width: 14px; height: 1.5px; }
  .qr__signe::after {
    width: 1.5px;
    height: 14px;
    transition: transform var(--d-normal) var(--e-mecanique);
  }
  .qr[open] .qr__signe::after { transform: scaleY(0); }

  .qr__r {
    max-width: 60ch;
    padding-bottom: var(--e-5);
    color: var(--texte-faible);
    font-size: var(--t-petit);
  }

  /* ── Bascule noir et blanc → couleur ── */
  .vue { padding-bottom: var(--e-7); }
  .vue__titre { max-width: 20ch; margin-bottom: var(--e-7); }
  .vue__legende { margin-top: var(--e-4); color: var(--acier-sombre); text-transform: none; }

  /* ── Conversion ── */
  .conversion { background: var(--marine); }
  .conversion__inner { max-width: 46rem; }
  .conversion__titre { font-size: var(--t-h2); max-width: 22ch; margin-bottom: var(--e-5); }
  .conversion__texte { max-width: 50ch; color: var(--acier); }
  .conversion__actions { display: flex; flex-wrap: wrap; gap: var(--e-3); margin-top: var(--e-7); }
  /* ── Suite ────────────────────────────────────────────────────────── */
  .suite__titre { max-width: 20ch; margin-bottom: var(--e-6); }
  .suite__liste { list-style: none; border-top: 1px solid var(--trait); }
  .suite__liste li { border-bottom: 1px solid var(--trait); }
  .suite__liste a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--e-2) var(--e-4);
    padding: var(--e-5) 0;
    text-decoration: none;
    color: inherit;
    transition: padding-left var(--d-normal) var(--e-sortie);
  }
  .suite__liste a:hover { padding-left: var(--e-4); }
  .suite__nom {
    font-family: var(--police-titre);
    font-size: var(--t-h3);
    letter-spacing: -0.02em;
  }
  .suite__liste a:hover .suite__nom { color: var(--signal-texte); }
  .suite__q { grid-column: 1; color: var(--texte-faible); text-transform: none; }
  .suite__fleche {
    grid-row: span 2;
    font-size: 1.25rem;
    transition: transform var(--d-normal) var(--e-sortie);
  }
  .suite__liste a:hover .suite__fleche { transform: translateX(5px); }
</style>
