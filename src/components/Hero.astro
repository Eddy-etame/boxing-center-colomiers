---
/**
 * H01 — L'ORIGINE.
 *
 * En quelques secondes le visiteur doit comprendre quatre choses : qu'on
 * parle bien de Colomiers, que Boxing Center le concerne, que cette page
 * l'aide à choisir, et qu'il y a une action immédiate.
 *
 * La photo est en noir et blanc. C'est délibéré : rien n'est encore décidé,
 * donc rien n'est encore en couleur. La couleur arrive plus bas dans la page,
 * quand le visiteur a choisi — et ce sont de vraies prises couleur du même
 * instant, pas un filtre CSS retiré.
 *
 * La route se trace au chargement : elle part du bord, marque COLOMIERS, et
 * repart vers le bas de l'écran. Elle ne décore pas un vide, elle annonce la
 * mécanique de tout le site.
 */
import Photo from './Photo.astro';
import { HORAIRES } from '../data/verite';
---

<section class="hero" aria-labelledby="t-hero">
  <div class="hero__fond">
    <Photo
      slug="club-boxe-colomiers-boxing-center"
      prioritaire
      sizes="100vw"
      ratio="16 / 9"
      class="hero__photo"
    />
  </div>

  <!-- La route. Purement décorative pour l'assistance : l'information
       qu'elle porte est écrite juste à côté, en texte. -->
  <svg class="hero__route" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <!-- Le tracé passe DERRIÈRE le texte, entre par la gauche, marque le
         nœud d'origine, puis repart vers le bas de page : il annonce que
         quelque chose continue plus bas. -->
    <path
      class="hero__trace hero__trace--fantome"
      d="M -20 232 L 176 232 L 232 288 L 232 742 L 288 798 L 1460 798"
      fill="none"
    />
    <path
      class="hero__trace hero__trace--vif"
      d="M -20 232 L 176 232 L 232 288 L 232 742 L 288 798 L 1460 798"
      fill="none"
    />
    <circle class="hero__halo" cx="232" cy="288" r="14" />
    <circle class="hero__noeud" cx="232" cy="288" r="4.5" />
  </svg>

  <div class="enveloppe hero__inner">
    <p class="hero__origine mono">
      <span class="hero__point" aria-hidden="true"></span>
      Colomiers, Haute-Garonne
    </p>

    <h1 id="t-hero" class="hero__titre">
      <span class="hero__ligne">Ton club de boxe</span>
      <span class="hero__ligne">et de MMA</span>
      <span class="hero__ligne hero__ligne--accent">près de Colomiers</span>
    </h1>

    <p class="hero__reponse">
      <strong>Deux clubs Boxing Center t’accueillent à proximité de Colomiers.</strong>
      Boxe anglaise, MMA, kick-boxing, grappling, boxing fitness, boxe enfants&nbsp;:
      chaque discipline a son club, et cette page te dit lequel.
    </p>

    <div class="hero__actions">
      <a class="bouton bouton--signal" href="#ton-parcours">
        <span>Trouver mon club</span>
        <span class="fleche" aria-hidden="true">↓</span>
      </a>
      <a class="bouton" href="/boxe-anglaise/">
        <span>Voir les disciplines</span>
        <span class="fleche" aria-hidden="true">→</span>
      </a>
    </div>

    <dl class="hero__faits">
      <div>
        <dt class="mono">Amplitude</dt>
        <dd>{HORAIRES.texte.valeur}</dd>
      </div>
      <div>
        <dt class="mono">Clubs</dt>
        <dd>Toulouse Minimes &amp; Portet-sur-Garonne</dd>
      </div>
      <div>
        <dt class="mono">Niveau requis</dt>
        <dd>Aucun</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    /* 100svh évite que la barre d'adresse mobile mange le bas. On retire la
       hauteur de l'en-tête collant : sinon le bandeau de faits se retrouve
       plaqué contre le bord inférieur, comme si la page était trop courte. */
    min-height: min(calc(100svh - 4.5rem), 58rem);
    padding-block: var(--e-8) var(--e-6);
    background: var(--encre);
    color: var(--os);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__fond {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero__fond :global(.hero__photo),
  .hero__fond :global(picture) {
    height: 100%;
    aspect-ratio: auto !important;
  }
  .hero__fond :global(img) {
    height: 100%;
    /* Le sujet est à droite du cadre : on décale le point de mire pour que
       le texte ne se pose jamais sur le boxeur. */
    object-position: 68% 42%;
  }

  /* Voile : la photo reste lisible, le texte reste au contraste. Deux
     dégradés croisés plutôt qu'un noir uniforme, pour garder la matière. */
  .hero__fond::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg, var(--encre) 4%, color-mix(in srgb, var(--encre) 72%, transparent) 42%, transparent 78%),
      linear-gradient(to top, var(--encre) 2%, transparent 55%);
  }

  /* Sur écran étroit, un voile latéral recouvre presque toute la largeur et
     la photo devient un rectangle sombre. On passe donc à un voile vertical :
     la salle reste visible en haut, le texte se pose sur le bas assombri. */
  @media (max-width: 52rem) {
    .hero__fond::after {
      background: linear-gradient(
        to top,
        var(--encre) 32%,
        color-mix(in srgb, var(--encre) 78%, transparent) 58%,
        color-mix(in srgb, var(--encre) 12%, transparent) 100%
      );
    }
    /* Le boxeur est à droite et à mi-hauteur du cadre : sur un écran étroit
       il faut aller le chercher, sinon on ne montre que le plafond. */
    .hero__fond :global(img) { object-position: 70% 40%; }
  }

  .hero__route {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero__trace {
    fill: none;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: miter;
  }

  /* Deux traits superposés : un fantôme sombre qui décolle la ligne de la
     photo quelle que soit la zone traversée, et le trait clair par-dessus.
     Sans le fantôme, la ligne disparaît sur les zones claires du cliché. */
  .hero__trace--fantome {
    stroke: var(--encre);
    stroke-width: 3.5;
    opacity: 0.55;
  }
  .hero__trace--vif {
    stroke: var(--acier);
    stroke-width: 1.25;
    opacity: 0.85;
  }

  .hero__trace {
    stroke-dasharray: 2900;
    stroke-dashoffset: 2900;
    animation: tracer 2.4s var(--e-resolution) 0.3s forwards;
  }
  @keyframes tracer { to { stroke-dashoffset: 0; } }

  /* Le nœud d'origine — Colomiers. Le seul rouge du premier écran avec le
     point de la sur-titre : rien d'autre n'est encore décidé. */
  .hero__noeud {
    fill: var(--signal);
    opacity: 0;
    animation: poser var(--d-normal) var(--e-sortie) 1.05s forwards;
  }
  .hero__halo {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1;
    opacity: 0;
    transform-origin: 232px 288px;
    animation: halo 2.8s ease-out 1.35s infinite;
  }
  @keyframes poser {
    from { opacity: 0; transform: scale(0.4); transform-origin: 232px 288px; }
    to { opacity: 1; transform: scale(1); transform-origin: 232px 288px; }
  }
  @keyframes halo {
    0% { opacity: 0.5; transform: scale(0.45); }
    70%, 100% { opacity: 0; transform: scale(1.6); }
  }

  .hero__inner { position: relative; width: 100%; }

  .hero__origine {
    display: flex;
    align-items: center;
    gap: var(--e-2);
    color: var(--acier);
    margin-bottom: var(--e-5);
  }
  .hero__point {
    width: 6px;
    height: 6px;
    border-radius: var(--rayon-rond);
    background: var(--signal);
    /* Battement lent : c'est un point d'origine vivant, pas une LED. */
    animation: battre 3.4s ease-in-out infinite;
  }
  @keyframes battre {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 color-mix(in srgb, var(--signal) 55%, transparent); }
    50% { opacity: 0.75; box-shadow: 0 0 0 5px transparent; }
  }

  .hero__titre {
    font-size: var(--t-h1);
    max-width: 16ch;
    margin-bottom: var(--e-5);
  }
  .hero__ligne {
    display: block;
    /* Chaque ligne monte derrière son propre masque : le titre se lève. */
    animation: monter var(--d-lent) var(--e-sortie) both;
    clip-path: inset(-0.2em 0 -0.2em 0);
  }
  .hero__ligne:nth-child(1) { animation-delay: 0.08s; }
  .hero__ligne:nth-child(2) { animation-delay: 0.16s; }
  .hero__ligne:nth-child(3) { animation-delay: 0.24s; }
  .hero__ligne--accent { color: var(--signal-texte); }

  @keyframes monter {
    from { opacity: 0; transform: translateY(0.5em); }
    to { opacity: 1; transform: none; }
  }

  .hero__reponse {
    max-width: 44ch;
    font-size: var(--t-lead);
    line-height: 1.45;
    color: var(--acier);
    margin-bottom: var(--e-6);
    animation: monter var(--d-lent) var(--e-sortie) 0.36s both;
  }
  .hero__reponse strong { color: var(--os); font-weight: 600; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    margin-bottom: var(--e-8);
    animation: monter var(--d-lent) var(--e-sortie) 0.44s both;
  }

  .hero__faits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--e-4) var(--e-6);
    max-width: 52rem;
    margin: 0;
    padding-top: var(--e-5);
    border-top: 1px solid var(--trait-sombre);
    animation: monter var(--d-lent) var(--e-sortie) 0.52s both;
  }
  .hero__faits dt { color: var(--acier-sombre); margin-bottom: 0.35rem; }
  .hero__faits dd {
    margin: 0;
    font-size: var(--t-petit);
    font-weight: 600;
    line-height: 1.35;
  }
  @media (max-width: 40rem) {
    .hero__faits { grid-template-columns: 1fr 1fr; }
    .hero__faits > div:last-child { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__trace { stroke-dashoffset: 0; animation: none; }
    .hero__noeud { opacity: 1; animation: none; }
    .hero__halo { display: none; }
    .hero__ligne,
    .hero__reponse,
    .hero__actions,
    .hero__faits { animation: none; }
    .hero__point { animation: none; }
  }
</style>
