---
import '../styles/jetons.css';
import '../styles/base.css';
import Entete from '../components/Entete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import Parcours from '../components/Parcours.astro';
import { route, type RouteId } from '../data/routes';
import { SITE, CLUBS, CONTACT, HORAIRES } from '../data/verite';
import { COMMUNES_VOISINES, CONTEXTE_GEO } from '../data/mots-cles';
import { DOIT_BLOQUER_LES_ROBOTS } from '../lib/environnement';
import { offresDuClub } from '../data/offres';

interface Props {
  page: RouteId;
  /** renseigne le parcours quand la page EST une décision de discipline */
  discipline?: 'boxe-anglaise' | 'mma' | 'boxing-fitness' | 'boxe-enfants';
  /** image de partage social, dans /public/photos */
  ogPhoto?: string;
  /**
   * Questions/réponses RÉELLEMENT visibles sur la page. On n'émet du FAQPage
   * que pour du contenu que le visiteur voit : baliser une FAQ invisible est
   * exactement ce que Google sanctionne.
   */
  faq?: readonly { titre: string; texte: string }[];
}

const { page, discipline, ogPhoto = 'club-boxe-colomiers-boxing-center', faq } = Astro.props;
const r = route(page);
const canonique = new URL(r.chemin, SITE.origine).href;
const og = new URL(`/photos/${ogPhoto}-1440.jpg`, SITE.origine).href;

/**
 * JSON-LD — il confirme le HTML visible, il n'ajoute jamais un fait que la
 * page ne dit pas. Aucun `LocalBusiness` n'est émis pour Colomiers : ce
 * serait déclarer un établissement qui n'existe pas.
 */
const donnees = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.origine}/#site`,
      url: SITE.origine + '/',
      name: SITE.nom,
      inLanguage: SITE.langue,
      publisher: { '@id': `${SITE.origine}/#organisation` },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.origine}/#organisation`,
      name: 'Boxing Center',
      url: SITE.origine + '/',
      telephone: CONTACT.telephone.valeur,
      email: CONTACT.email.valeur,
      /* Les vraies salles sont des entités distinctes, sur leurs vrais sites. */
      subOrganization: CLUBS.map((c) => ({
        '@type': 'SportsActivityLocation',
        '@id': `${c.site}#club`,
        name: c.nom,
        url: c.site,
        telephone: c.telephone,
        address: {
          '@type': 'PostalAddress',
          streetAddress: c.adresse.split(',')[0],
          postalCode: c.codePostal,
          addressLocality: c.ville,
          addressRegion: SITE.departement,
          addressCountry: 'FR',
        },
        openingHoursSpecification: {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
          opens: HORAIRES.ouverture.valeur,
          closes: HORAIRES.fermeture.valeur,
        },
        /* Les intitulés réellement publiés par CE club, pas une liste commune :
           Minimes ne propose pas de MMA, Portet oui. */
        sport: offresDuClub(c.id).map((o) => o.intitule),
      })),
      sameAs: CLUBS.map((c) => c.site),
      /* Le territoire réellement desservi : la commune d'origine et ses
         voisines, comme le demande le cahier des charges §1. */
      areaServed: [
        {
          '@type': 'City',
          name: SITE.villeOrigine,
          postalCode: CONTEXTE_GEO.codePostal,
          containedInPlace: { '@type': 'AdministrativeArea', name: SITE.departement },
        },
        ...COMMUNES_VOISINES.map((c) => ({
          '@type': 'City',
          name: c.nom,
          postalCode: c.cp,
          containedInPlace: { '@type': 'AdministrativeArea', name: SITE.departement },
        })),
      ],
    },
    {
      '@type': 'WebPage',
      '@id': `${canonique}#page`,
      url: canonique,
      name: r.titre,
      description: r.description,
      isPartOf: { '@id': `${SITE.origine}/#site` },
      inLanguage: SITE.langue,
      about: { '@id': `${SITE.origine}/#organisation` },
      primaryImageOfPage: og,
    },
    /* Fil d'Ariane : sur l'accueil il n'a pas lieu d'être. */
    ...(page === 'accueil'
      ? []
      : [
          {
            '@type': 'BreadcrumbList',
            '@id': `${canonique}#fil`,
            itemListElement: [
              { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE.origine}/` },
              { '@type': 'ListItem', position: 2, name: r.nav, item: canonique },
            ],
          },
        ]),
    /* FAQPage — uniquement si les questions sont visibles sur la page. */
    ...(faq?.length
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${canonique}#faq`,
            mainEntity: faq.map((q) => ({
              '@type': 'Question',
              name: q.titre,
              acceptedAnswer: { '@type': 'Answer', text: q.texte },
            })),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{r.titre}</title>
    <meta name="description" content={r.description} />
    <link rel="canonical" href={canonique} />
    {/* Un aperçu Vercel ne doit jamais concurrencer le domaine réel. */}
    {DOIT_BLOQUER_LES_ROBOTS ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      !r.index && <meta name="robots" content="noindex, follow" />
    )}

    {/* Contexte géographique : encore lu par plusieurs moteurs et agrégateurs. */}
    <meta name="geo.region" content="FR-31" />
    <meta name="geo.placename" content={`${CONTEXTE_GEO.ville}, ${CONTEXTE_GEO.departement}`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={r.titre} />
    <meta property="og:description" content={r.description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#07090D" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/logo.png" sizes="any" />

    <!-- Les deux fontes du premier écran sont préchargées ; le reste suit. -->
    <link rel="preload" href="/fonts/archivo-black-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Retire .no-js avant le premier rendu : pas de scintillement. -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(donnees)} />
  </head>

  <body data-discipline={discipline}>
    <a class="saut" href="#contenu">Aller au contenu</a>

    <Entete actuelle={page} />
    <Parcours />

    <main id="contenu">
      <slot />
    </main>

    <PiedDePage />

    <script>
      import { demarrer } from '../scripts/parcours';
      demarrer();

      // Révélations au scroll : une seule fois, puis on cesse d'observer.
      const cibles = document.querySelectorAll('.reveler');
      if (cibles.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const obs = new IntersectionObserver(
          (entrees) => {
            for (const e of entrees) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('vu');
              obs.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
        );
        cibles.forEach((c) => obs.observe(c));
      } else {
        cibles.forEach((c) => c.classList.add('vu'));
      }
    </script>
  </body>
</html>
